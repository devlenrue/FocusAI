{
  "name": "focusai",
  "version": "0.1.0",
  "private": true,
  "description": "FocusAI \u2014 an adaptive productivity workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --workspace=@focusai/api\" \"npm run dev --workspace=@focusai/web\"",
    "dev:api": "npm run dev --workspace=@focusai/api",
    "dev:web": "npm run dev --workspace=@focusai/web",
    "build": "npm run build --workspace=@focusai/decision-engine && npm run build --workspace=@focusai/api && npm run build --workspace=@focusai/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "type": "module"
}
