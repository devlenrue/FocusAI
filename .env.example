# Local API runtime
FOCUSAI_API_HOST=0.0.0.0
FOCUSAI_API_PORT=3001
FOCUSAI_DATABASE_PATH=./data/focusai.db
FOCUSAI_CORS_ORIGIN=http://localhost:5173

# Session cookies use opaque random tokens. In production, HTTPS is mandatory:
# NODE_ENV=production
# FOCUSAI_COOKIE_SECURE=true
# FOCUSAI_SESSION_TTL_DAYS=7

# Reserved for a future optional AI-provider adapter. Never commit real credentials.
# FOCUSAI_AI_PROVIDER=none
# FOCUSAI_AI_API_KEY=
